







<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Nestly" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nestly">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    
    

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">  

    
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  
  
  
  
  <body class="nestly-body">  
    <nav class="navbar navbar-expand-lg navbar-light nestly-navbar" data-turbo="false">
      <div class="container">
        
        <%= link_to "Nestly",
                    root_path,
                    class: "navbar-brand fw-bold" %>
        
        <div class="d-flex align-items-center ms-auto order-lg-3">
          <% if user_signed_in? %>
            <%= link_to account_path,
                        class: "nestly-user-link text-decoration-none fw-semibold me-2" do %>
              Hello,
              <%= current_user.name.presence || current_user.email %>
            <% end %>
          <% end %>
          
          <button
            class="navbar-toggler nestly-menu-button"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#nestlyNavbar"
            aria-controls="nestlyNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <span class="navbar-toggler-icon"></span>
          </button>
          
          <div class="d-none d-lg-flex align-items-center gap-2">
            <% if user_signed_in? %>
              <%= link_to "Account Details",
                          account_path,
                          class: "btn btn-sm btn-outline-dark" %>

              <%= button_to "Log Out",
                            destroy_user_session_path,
                            method: :delete,
                            class: "btn btn-sm btn-outline-dark",
                            form: { class: "d-inline-block m-0" } %>
            <% else %>
              <%= link_to "Log In",
                          new_user_session_path,
                          class: "btn btn-sm btn-outline-dark" %>

              <%= link_to "Register",
                          new_user_registration_path,
                          class: "btn btn-sm btn-nestly-light" %>
            <% end %>
          </div>
        </div>
        
        <div
          class="collapse navbar-collapse order-lg-2"
          id="nestlyNavbar"
        >
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <%= link_to "Home",
                          root_path,
                          class: "nav-link" %>
            </li>
            <% if user_signed_in? %>
              <li class="nav-item"><%= link_to 'Apartments', apartments_path, class: 'nav-link' %></li>
              <li class="nav-item"><%= link_to 'Inbox', inbox_path, class: 'nav-link' %></li>
            <li class="nav-item">
              <%= link_to "My Properties",
                          properties_path,
                          class: "nav-link" %>
            </li>
              <li class="nav-item">
                <%= link_to "Tour Requests",
                            tour_requests_path,
                            class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Received Requests",
                            received_tour_requests_path,
                            class: "nav-link" %>
              </li>
              
              <li class="nav-item d-lg-none">
                <%= link_to "Account Details",
                            account_path,
                            class: "nav-link" %>
              </li>
              <li class="nav-item d-lg-none">
                <%= button_to "Log Out",
                              destroy_user_session_path,
                              method: :delete,
                              class: "nav-link border-0 bg-transparent text-start w-100",
                              form: { class: "m-0" } %>
              </li>
            <% else %>
              
              <li class="nav-item d-lg-none">
                <%= link_to "Log In",
                            new_user_session_path,
                            class: "nav-link" %>
              </li>
              <li class="nav-item d-lg-none">
                <%= link_to "Register",
                            new_user_registration_path,
                            class: "nav-link fw-semibold" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>
    <main>
      
        <% if notice.present? || alert.present? %>
          <div class="container pt-3">
            <% if notice.present? %>
              <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= notice %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% end %>
            <% if alert.present? %>
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= alert %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% end %>
          </div>
        <% end %>
      
      <%= yield %>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
