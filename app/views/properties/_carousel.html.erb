 


<div id="carousel" class="carousel slide">
  <div class="carousel-inner">
    <% if @property.images.attached?  %>
      <% images = [@property.main_image] + @property.images.reject { |image| image.id == @property.main_image.id } %>
      <% images.each_with_index do |image, index|%>
        <div class="carousel-item <%= "active" if index == 0%>">
          <%= image_tag image, alt: "Picture #{index + 1} of property #{@property}", class: "d-block rounded w-100 pb-3" %>
        </div>
      <%end%>
    <% else %>
      <div class="carousel-item active">
        <%= image_tag "property-placeholder.jpg", alt: "House", class: "w-100 pb-3" %>
      </div>
    <% end %>
    <button class="carousel-control-prev" type="button" data-bs-target="#carousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>
</div>