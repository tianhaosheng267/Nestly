<% content_for :title, 'Find your neighborhood | Nestly' %>
<div class="container py-5 discovery-page">
  <div class="search-hero">
    <div class="search-intro"><span class="eyebrow">A PLACE TO CALL YOURS</span><h1>Find your next<br>neighborhood.</h1><p>Start with a ZIP code. Discover nearby apartment communities, save your favorites, and reach out when a place feels right.</p><div class="search-illustration" aria-hidden="true"><%= render 'apartments/buildings' %></div></div>
    <div class="card auth-card search-panel p-4 p-md-5">
      <h2 class="h3">Where do you want to live?</h2><p class="text-muted">Search apartment communities across the US.</p>
      <% if @search.errors.any? %><div class="alert alert-danger" role="alert"><%= @search.errors.full_messages.to_sentence %></div><% end %>
      <%= form_with model: @search, url: apartment_search_path, data: { controller: 'search-progress', action: 'submit->search-progress#start turbo:submit-end->search-progress#finish' } do |form| %>
        <div class="mb-4"><%= form.label :zip_code, 'ZIP code', class: 'form-label fw-semibold' %><%= form.text_field :zip_code, required: true, pattern: '[0-9]{5}', maxlength: 5, inputmode: 'numeric', autocomplete: 'postal-code', placeholder: '43214', class: 'form-control form-control-lg' %></div>
        <fieldset class="mb-4"><legend class="form-label fw-semibold fs-6">Search radius</legend><div class="radius-options">
          <% ApartmentSearch::RADII.each do |radius| %><label><%= form.radio_button :radius_miles, radius %><span><%= radius %> miles</span></label><% end %>
        </div></fieldset>
        <%= form.submit 'Find apartments', class: 'btn btn-primary btn-lg w-100', data: { search_progress_target: 'button', turbo_submits_with: 'Searching nearby…' } %>
        <p class="small text-muted mt-3 mb-0" role="status" data-search-progress-target="status">Distance is measured from the ZIP center, not driving distance.</p>
      <% end %>
      <div class="mt-4 pt-3 border-top"><%= link_to 'Browse manually listed homes instead →', root_path(manual: '1'), class: 'text-decoration-none' %></div>
    </div>
  </div>
  <p class="source-note mt-4">Free community discovery using <%= link_to 'OpenStreetMap', 'https://www.openstreetmap.org/copyright', target: '_blank', rel: 'noopener' %> and Zippopotam.us. Coverage varies; rental prices and availability are confirmed with the leasing office.</p>
</div>
