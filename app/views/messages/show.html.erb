


<div class="container messages-container">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="chat-page">
        <div class="chat-header">
          <%= link_to "‹",
                      messages_path,
                      class: "chat-back-button" %>
          <div class="chat-user-avatar">
            <%= @other_user.name.to_s.first&.upcase || "?" %>
          </div>
          <div class="chat-user-information">
            <h5 class="mb-0">
              Chat with
              <%= @other_user.name.presence ||
                  @other_user.email %>
            </h5>
            <%= link_to @property.address,
                        property_path(@property),
                        class: "chat-property" %>
          </div>
        </div>
        <div class="chat-messages" id="chatMessages">
          <% if @messages.any? %>
            <% @messages.each do |message| %>
              <% sent_message =
                   message.sender_id == current_user.id %>
              <div class="
                chat-message-row
                <%= sent_message ?
                    "chat-message-sent" :
                    "chat-message-received" %>
              ">
                <% unless sent_message %>
                  <div class="message-avatar">
                    <%= @other_user.name.to_s.first&.upcase || "?" %>
                  </div>
                <% end %>
                <div class="
                  chat-message-bubble
                  <%= sent_message ?
                      "sent-message-bubble" :
                      "received-message-bubble" %>
                ">
                  <p class="mb-1">
                    <%= message.content %>
                  </p>
                  <small class="message-time">
                    <%= message.created_at.in_time_zone.strftime("%-I:%M %p") %>
                  </small>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="empty-conversation">
              <div class="chat-user-large-avatar">
                <%= @other_user.name.to_s.first&.upcase || "?" %>
              </div>
              <p class="text-muted mb-1">
                You are viewing
                <%= @property.address %>
              </p>
              <h3>Say something!</h3>
              <p class="text-muted">
                Ask about availability, rent, amenities, or
                scheduling a tour.
              </p>
            </div>
          <% end %>
        </div>
        <div class="chat-form">
          <% if @message.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @message.errors.full_messages.each do |error| %>
                  <li><%= error %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <%= form_with model: @message,
                        url: messages_path,
                        html: { id: "messageForm" } do |form| %>
            <%= form.hidden_field :property_id,
                                  value: @property.id %>
            <%= form.hidden_field :receiver_id,
                                  value: @other_user.id %>
            <div class="message-input-row">
              <%= form.text_area :content,
                                 rows: 1,
                                 required: true,
                                 maxlength: 2_000,
                                 id: "messageContent",
                                 class: "form-control message-input",
                                 placeholder:
                                   "Type your message..." %>
              <%= form.submit "Send",
                              class: "btn message-send-button" %>
            </div>
          <% end %>
        </div>
        <%= render "shared/bottom_nav" %>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener("turbo:load", function() {
    const chatMessages = document.getElementById("chatMessages");
    const messageForm = document.getElementById("messageForm");
    const messageContent = document.getElementById("messageContent");
    if (chatMessages) {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
    if (messageForm && messageContent) {
      messageContent.onkeydown = function(event) {
        if (
          event.key === "Enter" &&
          !event.shiftKey &&
          !event.isComposing
        ) {
          event.preventDefault();
          if (messageContent.value.trim() !== "") {
            messageForm.requestSubmit();
          }
        }
      };
    }
  });
</script>